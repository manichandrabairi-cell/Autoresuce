{
  "name": "autorescue-platform",
  "version": "1.0.0",
  "description": "AutoRescue — AI-Powered Roadside Assistance & Towing Marketplace Platform",
  "private": true,
  "scripts": {
    "build:frontend": "npm run build --prefix frontend",
    "start:frontend": "npm run preview --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000 --reload",
    "start:backend": "python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000 --workers 4",
    "seed": "python backend/seed.py",
    "test:backend": "python backend/test_workflows.py"
  }
}
